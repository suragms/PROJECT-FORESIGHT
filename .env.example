# ==============================================================================
# PROJECT FORESIGHT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- RENDER BACKEND (Web Service / Docker) ---
FORESIGHT_ENV=production
FORESIGHT_LOG_LEVEL=INFO
FORESIGHT_API_AUTH_ENABLED=false
FORESIGHT_API_API_KEY=your-api-key-here
FORESIGHT_API_JWT_SECRET=your-jwt-secret-here
JWT_SECRET_KEY=your-jwt-secret-here
FORESIGHT_RATE_LIMIT_ENABLED=true
FORESIGHT_AUTH_DB_PATH=/tmp/foresight_auth.db
FORESIGHT_CORS_ORIGINS=https://foresight-project-green.vercel.app,http://localhost:3000,http://localhost:8501

# --- VERCEL FRONTEND (Edge CDN Web Dashboard) ---
FORESIGHT_API_URL=https://project-foresight-api-tofn.onrender.com
NEXT_PUBLIC_API_URL=https://project-foresight-api-tofn.onrender.com
VITE_API_URL=https://project-foresight-api-tofn.onrender.com

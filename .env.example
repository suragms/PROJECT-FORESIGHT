# Safe placeholders only. Copy to `.env` locally and fill secrets there.
# Never commit a real `.env`.

FORESIGHT_ENV=development
FORESIGHT_APP_VERSION=0.13.0
FORESIGHT_API_HOST=0.0.0.0
FORESIGHT_API_PORT=8000

FORESIGHT_API_AUTH_ENABLED=false
FORESIGHT_API_API_KEY=

FORESIGHT_RATE_LIMIT_ENABLED=false
FORESIGHT_RATE_LIMIT_REQUESTS=60
FORESIGHT_RATE_LIMIT_WINDOW_SECONDS=60
FORESIGHT_RATE_LIMIT_FORECAST_REQUESTS=20

FORESIGHT_API_MAX_BATCH=500
FORESIGHT_API_MAX_PAYLOAD_BYTES=2000000

FORESIGHT_LOG_LEVEL=INFO

{
  "framework": null,
  "buildCommand": "echo 'Static build'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "env": {
    "FORESIGHT_API_URL": "https://project-foresight-api-tofn.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://project-foresight-api-tofn.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://project-foresight-api-tofn.onrender.com/$1"
    },
    {
      "source": "/openapi.json",
      "destination": "https://project-foresight-api-tofn.onrender.com/openapi.json"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
